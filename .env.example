# Application
PROJECT_NAME=Todo Core Service
VERSION=1.0.0
API_V1_STR=/api/v1
DEBUG=True  # Swagger UI enabled when True; set False in production

# Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=fastapi
POSTGRES_PASSWORD=fastapi-password
POSTGRES_DB=fastapi_db

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis-password
REDIS_DB=0

# Security
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:8080"]

# Database pool
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30

# Cache
# Possible values: redis | memory
# Use 'memory' for local dev without Redis, 'redis' for production
CACHE_TYPE=redis
CACHE_TTL=300
